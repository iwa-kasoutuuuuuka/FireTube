<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Fire TV Leanback Theme -->
    <style name="Theme.FireTube" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="defaultBrandColor">@color/primary_red</item>
        <item name="defaultSearchColor">@color/primary_red</item>
        <item name="defaultSearchIcon">@drawable/ic_search</item>
        <item name="headersVerticalGridStyle">@style/FireTubeHeadersVerticalGridStyle</item>
    </style>

    <style name="FireTubeHeadersVerticalGridStyle" parent="Widget.Leanback.Headers.VerticalGridView">
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- Leanback Player Theme -->
    <style name="Theme.FireTube.Player" parent="Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
